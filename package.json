{
  "name": "tutela-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "API du service Tuteurs — plateforme éducative camerounaise",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/serveur.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/serveur.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "verifier": "npm run typecheck && npm run lint && npm run test:ia && npm run test:programme && npm run build",
    "test:ia": "tsx tests/ia.ts",
    "test:programme": "tsx --test tests/programme.test.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@fastify/sensible": "^6.0.0",
    "@fastify/swagger": "^9.4.0",
    "@fastify/swagger-ui": "^6.1.1",
    "@supabase/supabase-js": "^2.58.0",
    "@types/pg": "^8.23.1",
    "fastify": "^5.2.0",
    "fastify-plugin": "^5.0.0",
    "pg": "^8.23.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.10.0",
    "@types/ws": "^8.18.1",
    "eslint": "^9.39.5",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.70.1"
  },
  "engines": {
    "node": ">=22.0.0 <25.0.0"
  }
}
