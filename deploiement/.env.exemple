# Copier vers .env sur le serveur, et remplir.
#
# Ce fichier ne va JAMAIS dans Git. Il contient la clé de service, qui
# contourne toutes les politiques de sécurité : c'est la seule qui, si elle
# fuit, donne accès aux pièces d'identité et aux enregistrements de séances.

# ── Postgres ────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=
POSTGRES_DB=postgres
POSTGRES_PORT=5432

# ── Les secrets de Supabase ─────────────────────────────────────────────────
# Générer avec : openssl rand -base64 48
JWT_SECRET=

# Les deux clés se dérivent du JWT_SECRET. Supabase fournit un générateur :
# https://supabase.com/docs/guides/self-hosting#api-keys
ANON_KEY=
SERVICE_ROLE_KEY=

# ── Adresses publiques ──────────────────────────────────────────────────────
SITE_URL=https://tutela.cm
API_EXTERNAL_URL=https://api.tutela.cm
SUPABASE_PUBLIC_URL=https://api.tutela.cm

# ── Courrier ────────────────────────────────────────────────────────────────
# Sans SPF et DKIM sur le domaine, les messages partent en indésirable.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=TUTELA
SMTP_ADMIN_EMAIL=

# ── Le service Tuteurs ──────────────────────────────────────────────────────
ORIGINES_AUTORISEES=https://tutela.cm
