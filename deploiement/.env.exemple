# ═══════════════════════════════════════════════════════════════════════════
# TUTELA — toutes les variables d'un déploiement sur sa propre machine.
#
# Copier vers `.env` sur le serveur, remplir ce qui est vide, et déployer.
# Rien d'autre à chercher ailleurs : ce fichier est la liste complète.
#
# Il ne va JAMAIS dans Git. Il contient la clé de service, qui contourne
# toutes les politiques de sécurité — c'est la seule qui, si elle fuit, donne
# accès aux pièces d'identité et aux enregistrements de séances.
#
# Les lignes commentées sont des valeurs facultatives ou des exemples. Les
# décommenter suffit ; aucune ne doit être inventée.
# ═══════════════════════════════════════════════════════════════════════════


# ── 1. Postgres ────────────────────────────────────────────────────────────
# La base elle-même. Le mot de passe est celui de l'utilisateur `postgres`,
# qui peut tout lire et tout écrire : à ne mettre nulle part ailleurs.
POSTGRES_PASSWORD=
POSTGRES_DB=postgres
POSTGRES_PORT=5432


# ── 2. Les secrets de Supabase ─────────────────────────────────────────────
# Générer avec : openssl rand -base64 48
JWT_SECRET=

# Les deux clés se dérivent du JWT_SECRET. Supabase fournit un générateur :
# https://supabase.com/docs/guides/self-hosting#api-keys
#
# ANON_KEY part dans le navigateur de chaque élève — c'est prévu, la RLS
# protège les données. SERVICE_ROLE_KEY contourne la RLS : elle ne sort
# jamais du serveur.
ANON_KEY=
SERVICE_ROLE_KEY=


# ── 3. Adresses publiques ──────────────────────────────────────────────────
SITE_URL=https://tutela.cm
API_EXTERNAL_URL=https://api.tutela.cm
SUPABASE_PUBLIC_URL=https://api.tutela.cm


# ── 4. Courrier ────────────────────────────────────────────────────────────
# Sans SPF ni DKIM sur le domaine, les messages partent en indésirable — et
# personne ne va les y chercher. C'est par là que passent la confirmation
# d'inscription et la récupération de mot de passe.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=TUTELA
SMTP_ADMIN_EMAIL=

# Combien de temps vaut un lien reçu par courriel, en SECONDES.
#
# À garder d'accord avec le paramètre `duree_demande_mot_de_passe_minutes`,
# réglable depuis l'espace d'administration, qui gouverne l'autre canal : la
# demande affichée dans l'espace du parent. Deux canaux qui expirent à des
# moments différents, c'est une confusion garantie.
#
# Ne touche QUE les liens et codes du courriel. Les jetons de session et de
# rafraîchissement sont gouvernés ailleurs et ne bougent pas.
GOTRUE_MAILER_OTP_EXP=600


# ── 5. Le service Tuteurs ──────────────────────────────────────────────────
# Le service ne détient aucun pouvoir propre sur la base : il ne connaît que
# la clé publiable et retransmet le jeton de la personne qui l'appelle. C'est
# ce qui garantit que les règles de protection des élèves restent écrites à
# un seul endroit — les politiques RLS.
PORT=3001
ORIGINES_AUTORISEES=https://tutela.cm
SUPABASE_URL=https://api.tutela.cm
SUPABASE_CLE_PUBLIABLE=

# La SEULE exception à ce qui précède, et elle est étroite.
#
# Le service doit lire la clé du fournisseur d'IA, posée depuis l'espace
# d'administration. Ce laissez-passer est un rôle Postgres dont l'unique
# droit au monde est d'exécuter `cle_du_fournisseur()`, d'ajouter au registre
# de consommation et de débiter des jetons. Il ne peut lire ni les profils,
# ni les séances, ni les messages, ni la table des clés elle-même.
#
# Si ce mot de passe fuit, l'attaquant obtient la clé de l'IA — exactement ce
# qu'il aurait obtenu si elle était dans ce fichier. Rien de plus.
#
# Le créer une fois :
#   openssl rand -base64 24 | tr -d '/+=' | head -c 24
#   psql "$URL_BASE" -c "alter role service_ia password 'CE_MOT_DE_PASSE';"
BASE_SERVICE_IA=postgresql://service_ia:MOT_DE_PASSE@localhost:5432/postgres


# ── 6. Le site ─────────────────────────────────────────────────────────────
# À poser dans le `.env.local` du dossier WEB, ou dans l'environnement de la
# machine qui le sert.
#
# NEXT_PUBLIC_ envoie la valeur dans le navigateur de chaque visiteur : n'y
# mettre que ce qui peut être public.
NEXT_PUBLIC_SUPABASE_URL=https://api.tutela.cm
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# L'adresse du service Tuteurs, vue depuis le serveur du site. Sans elle, le
# site ne parle à rien : l'annuaire, les dossiers et le tuteur restent vides
# sans qu'aucune erreur ne l'explique.
#
# Sans NEXT_PUBLIC_ : les appels partent du serveur, jamais du navigateur.
# L'adresse du service n'a donc pas à être publique.
API_URL=https://api.tutela.cm

# Le pays par défaut d'un compte créé sans en indiquer un.
NEXT_PUBLIC_PAYS_PAR_DEFAUT=CM


# ── 7. Ce qui ne vit PAS ici ───────────────────────────────────────────────
# Volontairement, et il ne faut pas l'ajouter :
#
#   — la clé d'Anthropic, de Gemini ou de votre propre modèle. Elle se pose
#     depuis l'espace d'administration, dans « Clés », et se change sans
#     redéployer. C'était tout l'intérêt de la ranger en base.
#
#   — les clés de la carte, d'Orange Money et de MTN. Même endroit, même
#     raison.
#
#   — les plafonds de jetons, les modèles servis, la durée des demandes, les
#     modules allumés ou éteints. Tout cela est dans `parametres`, réglable
#     depuis l'espace d'administration.
